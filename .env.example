# Ahrefs API v3 key (Bearer token). Required for the Ahrefs stage of
# scripts/collect-keywords.ts. If unset, the script skips Ahrefs and runs
# with Google Autocomplete only (all metric columns will be null).
AHREFS_API_KEY=

# SerpApi-compatible key (https://serpapi.com or equivalent), used by
# scripts/cluster.ts to fetch real google.co.uk top-10 results, and by
# scripts/analyze-serp.ts for competitor-derived content targets. If unset,
# both scripts fall back to a clearly-labelled heuristic (see their file
# headers) instead of fabricating SERP data.
SERP_API_KEY=

# Anthropic API key. Required for scripts/generate-content.ts to call
# claude-sonnet-4-6 for real content generation. If unset, the script uses
# the hand-authored offline content corpus in scripts/lib/core-pages.ts /
# scripts/lib/trust-pages.ts instead (see README "Content generation
# without an LLM API key").
ANTHROPIC_API_KEY=

# URL of a verified UK Gambling Commission licence-status lookup endpoint,
# returning { "results": [{ "status": "Active" | ... }] } for ?q=<account
# number>. The Commission does not publish a documented public JSON API
# (only an interactive search UI and periodic CSV/Excel exports) - point
# this at your own mirror of that export or a licensed third-party
# verification service. If unset, scripts/compliance-check.ts treats every
# operator as unverified rather than assuming compliance.
UKGC_REGISTER_LOOKUP_URL=
